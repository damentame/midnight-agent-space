# Temporal worker local defaults.
# Copy to temporal/.env and customize for your machine.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=midnight_agent_space_dev
DB_USER=postgres
DB_PASSWORD=change_me

TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
WORKSPACE_ROOT=

AGENT_PROVIDER_DEFAULT=codex
HERMES_ENABLED=false
HERMES_COMMAND=hermes

OPENAI_API_KEY=
CODEX_API_URL=https://api.openai.com/v1
CODEX_MODEL=gpt-4.1-mini
CODEX_MODEL_FAST=
CODEX_MODEL_COMPLEX=
CODEX_COMMAND=codex
CODEX_APPROVAL_MODE=never
CODEX_SANDBOX_MODE=workspace-write
CODEX_DEFAULT_TIMEOUT_SECONDS=900

CURSOR_API_KEY=
CURSOR_API_URL=https://api.cursor.com/v0
CURSOR_MODEL_FAST=
CURSOR_MODEL_COMPLEX=

ANTHROPIC_API_KEY=
CLAUDE_CODE_MODEL=claude-sonnet-4-20250514

MIDNIGHT_DEFAULT_RUNTIME=codex-cli
MIDNIGHT_MAX_CONCURRENCY=1
MIDNIGHT_WORKTREE_BASE_PATH=
MIDNIGHT_RUN_ARTIFACT_PATH=

# Backward-compatible legacy keys (optional)
# CODEX_CLI_BIN=codex
# CODEX_CLI_TIMEOUT_SECONDS=900
# CODEX_CLI_APPROVAL_MODE=never
# CODEX_CLI_SANDBOX_MODE=workspace-write
