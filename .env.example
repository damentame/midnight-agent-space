# ============================================================
# Midnight Agent Space - local example environment
# ============================================================

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=midnight_agent_space_dev
DB_USER=postgres
DB_PASSWORD=change_me
DB_POOL_MIN=1
DB_POOL_MAX=10

# Dashboard API
DASHBOARD_API_HOST=0.0.0.0
DASHBOARD_API_PORT=8001
DASHBOARD_DEBUG=true

# Temporal
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
WORKSPACE_ROOT=

# Agent runtime defaults
AGENT_PROVIDER_DEFAULT=codex
CURSOR_AGENT_COMMAND=cursor-agent
CURSOR_AGENT_MODEL=
MIDNIGHT_REVIEWER_RUNTIME=claude-cli
HERMES_ENABLED=false
HERMES_COMMAND=hermes
HERMES_API_URL=

# Codex/OpenAI provider
OPENAI_API_KEY=
CODEX_API_URL=https://api.openai.com/v1
CODEX_MODEL=gpt-4.1-mini
CODEX_MODEL_FAST=
CODEX_MODEL_COMPLEX=

# Cursor provider (optional)
CURSOR_API_KEY=
CURSOR_API_URL=https://api.cursor.com/v0
CURSOR_MODEL_FAST=
CURSOR_MODEL_COMPLEX=
CURSOR_REPOSITORY=
CURSOR_DEFAULT_BRANCH=main

# Claude Code provider (optional)
ANTHROPIC_API_KEY=
CLAUDE_CODE_MODEL=claude-sonnet-4-20250514
CLAUDE_CODE_MODEL_FAST=
CLAUDE_CODE_MODEL_COMPLEX=
CLAUDE_CODE_MAX_TURNS=200
CLAUDE_CODE_PERMISSION_MODE=default
CLAUDE_CODE_MAX_CONCURRENT=4

# Codex CLI runtime (dashboard quick-runs)
CODEX_COMMAND=codex
CODEX_APPROVAL_MODE=never
CODEX_SANDBOX_MODE=workspace-write
CODEX_DEFAULT_TIMEOUT_SECONDS=900
CODEX_CLI_MODEL=gpt-4.1-mini
CODEX_CLI_MODEL_FAST=gpt-4.1-mini
CODEX_CLI_MODEL_COMPLEX=gpt-4.1

# Claude CLI runtime (dashboard quick-runs)
CLAUDE_COMMAND=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_MODEL_FAST=haiku
CLAUDE_CLI_MODEL_COMPLEX=sonnet
CLAUDE_CLI_TIMEOUT_SECONDS=900
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash

# Midnight runtime + paths (codex-cli | claude-cli)
MIDNIGHT_DEFAULT_RUNTIME=codex-cli
MIDNIGHT_MAX_CONCURRENCY=1
MIDNIGHT_WORKTREE_BASE_PATH=
MIDNIGHT_RUN_ARTIFACT_PATH=

# Backward-compatible legacy keys (optional)
# Optional server-side Figma token (UI token in Settings overrides per import)
# FIGMA_ACCESS_TOKEN=

# CODEX_CLI_BIN=codex
# CODEX_CLI_TIMEOUT_SECONDS=900
# CODEX_CLI_APPROVAL_MODE=never
# CODEX_CLI_SANDBOX_MODE=workspace-write

# Embeddings/chunking
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY=1.0
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
