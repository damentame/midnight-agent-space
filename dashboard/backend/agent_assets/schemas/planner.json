{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planner Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_title", "summary", "tasks"],
  "properties": {
    "run_title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "slug",
          "description",
          "task_type",
          "depends_on",
          "target_files",
          "acceptance_criteria"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "task_type": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "target_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
